# Copy this file to .env and fill in your values. Never commit .env.

# --- Voice Live (realtime conversation) ---
# Foundry / Cognitive Services resource endpoint.
# Looks like: https://<your-resource>.cognitiveservices.azure.com/
AZURE_VOICELIVE_ENDPOINT=

# Resource API key. Server-side only, never shipped to the browser.
AZURE_VOICELIVE_API_KEY=

# Model that does the "thinking". Voice Live deploys this for you.
AZURE_VOICELIVE_MODEL=gpt-realtime

# Malayalam has exactly two voices on Azure TTS. That is the whole palette:
# no HD tier, no emotion styles, no neutral option.
# The user picks between them before the session starts.
AZURE_VOICELIVE_VOICE=ml-IN-MidhunNeural
AZURE_VOICELIVE_VOICE_FEMALE=ml-IN-SobhanaNeural

# A full English sentence spoken by a Malayalam voice is unintelligible, so
# English mode (not yet exposed in the UI) needs its own voice.
AZURE_VOICELIVE_VOICE_EN=en-IN-Arjun:DragonHDLatestNeural

# Speech-to-text languages. Malayalam is NOT in the default multilingual
# model, so it must be listed explicitly. First entry is primary.
AZURE_VOICELIVE_STT_LANGUAGES=ml-IN,en-IN

# --- Image understanding (one call per upload) ---
# Foundry Models inference endpoint. May differ from the Voice Live endpoint.
AZURE_VISION_ENDPOINT=
AZURE_VISION_API_KEY=
AZURE_VISION_MODEL=gpt-4.1

# --- Misc ---
DEBUG=false
